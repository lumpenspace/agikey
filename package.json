{
  "name": "agikey",
  "version": "1.0.1",
  "description": "Local text API gateway and dashboard for agy, Claude Code, Grok and Codex CLIs",
  "main": "src/server.js",
  "bin": {
    "agikey": "./bin/agikey.js",
    "agiary": "./bin/agikey.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE",
    "docs",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "start": "node bin/agikey.js serve",
    "serve": "node bin/agikey.js serve",
    "dev": "node --watch bin/agikey.js serve",
    "discover": "node bin/agikey.js discover",
    "scan": "node bin/agikey.js discover",
    "check": "node bin/agikey.js check",
    "status": "node bin/agikey.js status",
    "models": "node bin/agikey.js models",
    "conversations": "node bin/agikey.js conversations",
    "convs": "node bin/agikey.js conversations",
    "chat": "node bin/agikey.js chat",
    "test": "node --test test/*.test.js",
    "test:live": "node scripts/smoke-live.js",
    "release:check": "npm test && node scripts/release-check.js",
    "site:preview": "node scripts/preview-site.js",
    "prepublishOnly": "npm run release:check"
  },
  "homepage": "https://agikey.hyperplex.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumpenspace/agikey.git"
  },
  "bugs": {
    "url": "https://github.com/lumpenspace/agikey/issues"
  },
  "keywords": [
    "openai",
    "api",
    "gateway",
    "claude-code",
    "agy",
    "antigravity",
    "grok",
    "codex",
    "chatgpt",
    "streaming",
    "sse",
    "llm"
  ],
  "author": "Claudio Brandolino",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
